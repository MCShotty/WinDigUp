+int ggml_backend_accelerator_policy_version(void) {
+#ifdef GGML_ACCELERATOR_ONLY
+    return 2;
+#else
+    return 0;
+#endif
+}
+
+bool ggml_backend_vulkan_vendor_allowed(uint32_t vendor_id) {
+#ifdef GGML_ACCELERATOR_ONLY
+    return vendor_id != 0x10de; // NVIDIA is CUDA-only in this fork.
+#else
+    return true;
+#endif
+}
+
+bool ggml_backend_dev_accelerator_info(ggml_backend_dev_t device, ggml_accelerator_device_info * info) {
+    if (!device || !info) { return false; }
+    memset(info, 0, sizeof(*info));
+    using get_info = bool (*)(ggml_backend_dev_t, ggml_accelerator_device_info *);
+    auto fn = reinterpret_cast<get_info>(ggml_backend_reg_get_proc_address(device->reg, "digup_device_info_v1"));
+    return fn && fn(device, info);
+}
