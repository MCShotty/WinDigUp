+static bool digup_vulkan_device_info(ggml_backend_dev_t dev, ggml_accelerator_device_info * info) {
+    auto * ctx = static_cast<ggml_backend_vk_device_context *>(dev->context);
+    auto devices = vk_instance.instance.enumeratePhysicalDevices();
+    auto physical = devices.at(vk_instance.device_indices.at(ctx->device));
+    vk::PhysicalDeviceProperties2 props;
+    vk::PhysicalDeviceIDProperties id;
+    props.pNext = &id;
+    physical.getProperties2(&props);
+    if (!ggml_backend_vulkan_vendor_allowed(props.properties.vendorID)) { return false; }
+    info->vendor_id = props.properties.vendorID;
+    #ifdef GGML_ACCELERATOR_ONLY
+    info->policy_version = 2;
+#else
+    info->policy_version = 0;
+#endif
+    snprintf(info->stable_id, sizeof(info->stable_id), "VK-%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x%02x",
+        id.deviceUUID[0], id.deviceUUID[1], id.deviceUUID[2], id.deviceUUID[3],
+        id.deviceUUID[4], id.deviceUUID[5], id.deviceUUID[6], id.deviceUUID[7],
+        id.deviceUUID[8], id.deviceUUID[9], id.deviceUUID[10], id.deviceUUID[11],
+        id.deviceUUID[12], id.deviceUUID[13], id.deviceUUID[14], id.deviceUUID[15]);
+    return true;
+}
+
+static void * digup_vulkan_proc(ggml_backend_reg_t reg, const char * name) {
+    GGML_UNUSED(reg);
+    return strcmp(name, "digup_device_info_v1") == 0 ? reinterpret_cast<void *>(digup_vulkan_device_info) : nullptr;
+}
