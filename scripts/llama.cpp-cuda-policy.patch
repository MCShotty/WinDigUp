+static bool digup_cuda_device_info(ggml_backend_dev_t dev, ggml_accelerator_device_info * info) {
+    auto * ctx = static_cast<ggml_backend_cuda_device_context *>(dev->context);
+    cudaDeviceProp props;
+    if (cudaGetDeviceProperties(&props, ggml_cuda_get_physical_device(ctx->device)) != cudaSuccess) { return false; }
+    info->vendor_id = 0x10de;
+    info->compute_capability = props.major * 10 + props.minor;
+    if (cudaDriverGetVersion(&info->driver_version) != cudaSuccess ||
+        cudaRuntimeGetVersion(&info->runtime_version) != cudaSuccess) { return false; }
+    #ifdef GGML_ACCELERATOR_ONLY
+    info->policy_version = 2;
+#else
+    info->policy_version = 0;
+#endif
+    const auto * id = reinterpret_cast<const unsigned char *>(props.uuid.bytes);
+    snprintf(info->stable_id, sizeof(info->stable_id), "GPU-%02x%02x%02x%02x-%02x%02x-%02x%02x-%02x%02x-%02x%02x%02x%02x%02x%02x",
+        id[0],id[1],id[2],id[3],id[4],id[5],id[6],id[7],id[8],id[9],id[10],id[11],id[12],id[13],id[14],id[15]);
