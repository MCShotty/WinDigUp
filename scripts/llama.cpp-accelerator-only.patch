--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -585,10 +585,55 @@ void ggml_backend_graph_plan_free(ggml_backend_t backend, ggml_backend_graph_pla
     backend->iface.graph_plan_free(backend, plan);
 }
 
+bool ggml_backend_accelerator_only(void) {
+#ifdef GGML_ACCELERATOR_ONLY
+    return true;
+#else
+    return false;
+#endif
+}
+
+#ifdef GGML_ACCELERATOR_ONLY
+static bool accelerator_backend(ggml_backend_t backend) {
+    const auto type = ggml_backend_dev_type(backend->device);
+    return type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU;
+}
+
+static bool accelerator_graph(ggml_backend_t backend, const ggml_cgraph * graph) {
+    if (accelerator_backend(backend)) {
+        return true;
+    }
+    for (int i = 0; i < graph->n_nodes; ++i) {
+        const auto * node = graph->nodes[i];
+        switch (node->op) {
+            case GGML_OP_NONE:
+            case GGML_OP_VIEW:
+            case GGML_OP_RESHAPE:
+            case GGML_OP_PERMUTE:
+            case GGML_OP_TRANSPOSE:
+                break; // storage metadata, no arithmetic
+            default:
+                GGML_LOG_ERROR("accelerator-only: refusing %s (%s) on %s; no CPU fallback\n",
+                               ggml_op_name(node->op), node->name, ggml_backend_name(backend));
+                return false;
+        }
+    }
+    return true;
+}
+#endif
+
 enum ggml_status ggml_backend_graph_plan_compute(ggml_backend_t backend, ggml_backend_graph_plan_t plan) {
     GGML_ASSERT(backend);
     GGML_ASSERT(backend->iface.graph_plan_compute != NULL);
 
+#ifdef GGML_ACCELERATOR_ONLY
+    // Plans are opaque. A host backend's plan cannot be inspected safely.
+    if (!accelerator_backend(backend)) {
+        GGML_LOG_ERROR("accelerator-only: refusing host graph plan on %s\n", ggml_backend_name(backend));
+        return GGML_STATUS_FAILED;
+    }
+#endif
+
     return backend->iface.graph_plan_compute(backend, plan);
 }
 
