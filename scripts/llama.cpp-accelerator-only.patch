 enum ggml_status ggml_backend_graph_compute_async(ggml_backend_t backend, struct ggml_cgraph * cgraph) {
     GGML_ASSERT(backend);
+#ifdef GGML_ACCELERATOR_ONLY
+    if (!accelerator_graph(backend, cgraph)) {
+        return GGML_STATUS_FAILED;
+    }
+    if (!accelerator_backend(backend)) {
+        return GGML_STATUS_SUCCESS; // metadata-only graph: nothing to compute
+    }
+#endif
     return backend->iface.graph_compute(backend, cgraph);
 }
 
